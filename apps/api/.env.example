DATABASE_URL="postgresql://recipehub:recipehub@localhost:5432/recipehub?schema=public"
PORT=3000

JWT_SECRET=dev-secret-change-me

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=recipehub
MINIO_SECRET_KEY=recipehub123
MINIO_BUCKET=recipes

# Get a key at https://console.anthropic.com (API Keys section) — separate
# from a Claude.ai subscription, billed pay-as-you-go per token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Path to a Chromium-based browser, used by instagramScraper.ts's headless
# fallback only (since 2026-09-29 imports go through a plain fetch first —
# the browser is only launched when that fails, e.g. for restricted posts).
# Leave unset locally, it auto-detects Edge/Chrome/Chromium in their usual
# install locations. On the production Ubuntu server, set this after
# `apt install chromium` (typically /usr/bin/chromium) — without a browser,
# imports still work, restricted posts just get the generic fallback message.
PUPPETEER_EXECUTABLE_PATH=
