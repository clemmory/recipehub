{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    // "node" (aka "node10") moduleResolution is deprecated as of TS 5.5+
    // and will be removed in TS 7.0. Not migrating to "node16"/"nodenext"
    // here: this app is genuinely CommonJS end to end (dev via `tsx`,
    // prod via `tsc` + `node dist/server.js`, no "type": "module"). The
    // original blocker — `puppeteer-core` being ESM-only, which hard-fails
    // under "node16" resolution — is gone since puppeteer was removed on
    // 2026-09-29, so migrating is now possible; still out of scope just to
    // silence an editor warning, suppressed per TS's own suggested escape
    // hatch until there's an actual reason to convert.
    "ignoreDeprecations": "5.0",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src"]
}
