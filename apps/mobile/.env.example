EXPO_PUBLIC_API_URL=http://192.168.1.x:3000
# Use React Native's built-in fetch/FormData instead of Expo SDK 57's new fetch
# implementation, which does not support the classic RN `{ uri, name, type }`
# file part used for photo upload (throws "Unsupported FormDataPart implementation").
EXPO_PUBLIC_USE_RN_FETCH=1
